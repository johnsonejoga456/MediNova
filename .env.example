# 🔐 Environment Variables Template
# Copy this file to `.env.local` and fill in your actual values
# NEVER commit `.env.local` to version control!

# ============================================
# 🗄️ SUPABASE DATABASE CONNECTION
# ============================================
# Get these from: Supabase Dashboard → Settings → Database

# Pooling connection (for your app - better performance)
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# Direct connection (for migrations)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxxx.supabase.co:5432/postgres"

# ⚠️ IMPORTANT: Replace [YOUR-PASSWORD] with your actual Supabase database password!


# ============================================
# 🌐 SUPABASE API CREDENTIALS
# ============================================
# Get these from: Supabase Dashboard → Settings → API

# Your project URL
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxx.supabase.co"

# Public anon key (safe to use in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."


# ============================================
# 🔑 NEXTAUTH CONFIGURATION
# ============================================

# Your application URL
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# Secret key for encrypting JWT tokens
# Generate by running: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Or use: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-random-string-minimum-32-characters-long"


# ============================================
# 📧 EMAIL SERVICE (Optional - for later)
# ============================================
# For sending appointment reminders, password resets, etc.
# We'll use Resend.com

# EMAIL_FROM="noreply@yourhospital.com"
# RESEND_API_KEY="re_..."


# ============================================
# 💳 STRIPE (Optional - for billing later)
# ============================================
# For processing payments

# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."


# ============================================
# 📊 MONITORING (Optional - for production)
# ============================================

# Sentry (error tracking)
# NEXT_PUBLIC_SENTRY_DSN="https://...@sentry.io/..."

# ============================================
# 🔧 DEVELOPMENT SETTINGS
# ============================================

# Show detailed logs in development
NODE_ENV="development"


# ============================================
# ✅ QUICK SETUP CHECKLIST
# ============================================
# [ ] Created Supabase project
# [ ] Copied DATABASE_URL from Supabase
# [ ] Copied DIRECT_URL from Supabase
# [ ] Copied NEXT_PUBLIC_SUPABASE_URL
# [ ] Copied NEXT_PUBLIC_SUPABASE_ANON_KEY
# [ ] Generated NEXTAUTH_SECRET
# [ ] Saved this file as `.env.local` (remove .example)
# [ ] Restarted development server

# 💡 TIP: After setting up, run these commands:
# 1. npx prisma generate
# 2. npx prisma migrate dev --name init
# 3. npm run dev
